# App (nessun segreto)
EXPO_PUBLIC_API_URL=
# Web su host Node: usa / durante export:server. Nativo: origine HTTPS assoluta.
# Backend HTTPS separato dalla demo Sites
PUBLIC_ORIGIN=https://api.example.invalid
WEB_ORIGIN=https://api.example.invalid
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_API_VERSION=
APPLE_CLIENT_ID=
# Per il login nativo iOS: it.randomstranger.app, insieme a tutti gli altri campi Apple
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Override facoltativo: il progetto Expo/EAS reale è già collegato in src/project.mjs
EAS_PROJECT_ID=
RESTRICTED_BETA=true
BETA_ALLOWED_EMAILS=
DATABASE_PATH=./random-stranger.sqlite
PORT=8787
HOST=127.0.0.1
